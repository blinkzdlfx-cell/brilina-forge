{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "brilina-forge",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-10-08",
  "assets": {
    "directory": "./web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/auth/*",
      "/health"
    ]
  }
}
