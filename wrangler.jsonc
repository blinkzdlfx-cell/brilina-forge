{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "brilina-forge",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-10-08",
  "compatibility_flags": [
    "enable_request_signal",
    "nodejs_compat"
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    }
  },
  "assets": {
    "directory": "./web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/auth/*",
      "/health"
    ]
  },
  "vars": {
    "GITHUB_CLIENT_ID": "Iv23lieC3tc05OfuPNZR",
    "PUBLIC_BASE_URL": "https://brilina-forge.blinkzdlfx.workers.dev",
    "GITHUB_CALLBACK_URL": "https://brilina-forge.blinkzdlfx.workers.dev/auth/github/callback",
    "COOKIE_SECURE": "true",
    "AI_PROVIDER_BASE_URL": "https://api.cloudflare.com/client/v4/accounts/8b694686fda6c12625423d5055aa84b1/ai/v1",
    "AI_PROVIDER_MODEL": "@cf/zai-org/glm-4.7-flash",
    "AI_PROVIDER_TIMEOUT_MS": "120000"
  }
}
