NODE_ENV=development
HOST=0.0.0.0
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000

# GitHub App user authorization
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:3000/auth/github/callback

# Set to true only when serving over HTTPS.
COOKIE_SECURE=false

# Neon / Lakebase Postgres
DATABASE_URL=postgresql://...
# Base64-encoded 32-byte AES-256 key for encrypting GitHub OAuth tokens at rest
GITHUB_TOKEN_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key

# AI provider: start with Cloudflare Workers AI through its OpenAI-compatible
# Chat Completions endpoint. Replace <CLOUDFLARE_ACCOUNT_ID> with your account ID.
# Leave AI_PROVIDER_API_KEY empty only when intentionally using the deterministic
# development adapter; it is not a real AI coding test.
AI_PROVIDER_BASE_URL=https://api.cloudflare.com/client/v4/accounts/<CLOUDFLARE_ACCOUNT_ID>/ai/v1
AI_PROVIDER_MODEL=@cf/zai-org/glm-4.7-flash
AI_PROVIDER_API_KEY=
AI_PROVIDER_TIMEOUT_MS=120000

# Disposable execution worker root (Phase 6). Defaults to a
# brilina-forge-worker directory in the system temp directory.
EXECUTION_ROOT_DIR=

# GitHub App installation access (separate from user OAuth credentials)
GITHUB_APP_ID=
GITHUB_APP_SLUG=
# Store the PEM private key as a Cloudflare secret; escaped \\n is supported for local .dev.vars.
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_WEBHOOK_SECRET=
GITHUB_APP_SETUP_CALLBACK_URL=https://brilina-forge.blinkzdlfx.workers.dev/auth/github-app/callback

# Enable only after migration 008 is applied in production
GITHUB_MULTI_ACCOUNT_ENABLED=false
