NODE_ENV=development
HOST=0.0.0.0
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000

# GitHub App user authorization
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:3000/auth/github/callback

# Set to true only when serving over HTTPS.
COOKIE_SECURE=false

# Neon / Lakebase Postgres
DATABASE_URL=postgresql://...
# Base64-encoded 32-byte AES-256 key for encrypting GitHub OAuth tokens at rest
GITHUB_TOKEN_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key

# AI provider (Phase 5). Leave AI_PROVIDER_API_KEY unset to run the
# deterministic development adapter instead of a live model.
# Any OpenAI-compatible /chat/completions endpoint works.
AI_PROVIDER_BASE_URL=https://api.openai.com/v1
AI_PROVIDER_MODEL=gpt-4o-mini
AI_PROVIDER_API_KEY=
AI_PROVIDER_TIMEOUT_MS=120000

# Disposable execution worker root (Phase 6). Defaults to a
# brilina-forge-worker directory in the system temp directory.
EXECUTION_ROOT_DIR=
